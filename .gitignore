# Virtual environment
.venv/

# Node dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Environment variables / secrets
.env
.env.*

# Keep example environment files
!.env.example

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/

# Angular / TypeScript build artifacts and caches
.angular/
out-tsc/
*.tsbuildinfo
.sass-cache/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Type checker / linter caches
.mypy_cache/
.pyright/
.ruff_cache/
.cache/

# Temporary files
tmp/
temp/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db

# Logs
*.log
